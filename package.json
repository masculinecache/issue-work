{
  "name": "@masculinecache/issue-work",
  "version": "0.1.3",
  "description": "AXI-compliant GitHub issue triage + automation CLI — TOON output, confidence-gated implementation",
  "type": "module",
  "bin": { "issue-work": "bin/issue-work" },
  "files": ["bin/", "SKILL.md", "README.md"],
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const p=require('path');const d=p.join(require('os').homedir(),'.agents/skills/issue-automation');fs.mkdirSync(d,{recursive:true});fs.copyFileSync(p.join(__dirname,'SKILL.md'),p.join(d,'SKILL.md'));console.log('Skill installed to',d)\""
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/masculinecache/issue-work.git" },
  "keywords": ["github", "issues", "agents", "cli", "toon", "axi", "triage"],
  "publishConfig": { "access": "public", "provenance": true }
}
